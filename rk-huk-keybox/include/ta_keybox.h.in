#ifndef NAOS_SYSTEM_KEYBOX_H
#define NAOS_SYSTEM_KEYBOX_H

#define TA_KEYBOX_UUID @TA_KEYBOX_UUID@
#define NAOS_UUID_BYTES { @NAOS_UUID_BYTES@ }
#define NAOS_CMD_SEAL 0x10
#define NAOS_CMD_UNSEAL 0x11
#define NAOS_KEY_SIZE 32U
#define NAOS_KEY_HEX_SIZE 64U
#define NAOS_HEADER_SIZE 40U
#define NAOS_NONCE_SIZE 12U
#define NAOS_TAG_SIZE 16U
#define NAOS_BLOB_SIZE 100U
#define NAOS_NONCE_OFFSET NAOS_HEADER_SIZE
#define NAOS_CIPHER_OFFSET (NAOS_NONCE_OFFSET + NAOS_NONCE_SIZE)
#define NAOS_TAG_OFFSET (NAOS_CIPHER_OFFSET + NAOS_KEY_SIZE)
#endif
